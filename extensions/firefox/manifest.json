{
  "manifest_version": 3,
  "name": "Downlink — Media Downloader Companion",
  "version": "0.1.64",
  "description": "Capture videos, playlists, audio streams, and web media directly into Downlink Desktop with 1 click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "downlink@downlink.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:3984/*",
    "http://localhost:3984/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
