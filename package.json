{
  "name": "downlink",
  "version": "0.1.70",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-extension-versions.js && node scripts/ensure-binaries.js",
    "prebuild": "node scripts/sync-extension-versions.js && node scripts/ensure-binaries.js",
    "update-binaries": "node scripts/ensure-binaries.js --force",
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "eslint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "package:extensions": "node scripts/package-extensions.js",
    "release": "standard-version"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@vidstack/react": "^1.15.7",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-player": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "potrace": "^2.1.8",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
